{
  "name": "csharp-quality-mcp",
  "version": "0.1.0",
  "description": "SolidGuard MCP - an agentic C#/.NET code quality reviewer that AI coders can call as a tool. Combines deterministic Roslyn analysis, LLM reasoning, and a self-verifying refactor loop.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "csharp-quality-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "analyzers",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ai": "^5.0.0",
    "diff": "^7.0.0",
    "fast-xml-parser": "^4.5.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
