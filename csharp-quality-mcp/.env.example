# SolidGuard MCP - LLM configuration (optional)
# The deterministic layer (get_metrics, build diagnostics, metrics) works with
# NO key. An LLM is only used for the design-reasoning step of review_csharp.

# Provider: openai | anthropic | openai-compatible
SG_LLM_PROVIDER=openai

# Model id for the chosen provider
SG_LLM_MODEL=gpt-4o-mini

# API key (or use OPENAI_API_KEY / ANTHROPIC_API_KEY)
SG_LLM_API_KEY=

# For local models via an OpenAI-compatible endpoint (e.g. Ollama, LM Studio):
#   SG_LLM_PROVIDER=openai-compatible
#   SG_LLM_BASE_URL=http://localhost:11434/v1
#   SG_LLM_MODEL=qwen2.5-coder:7b
# SG_LLM_BASE_URL=

# --- Quality thresholds (optional overrides) ---
# SG_MAX_COMPLEXITY=10
# SG_MIN_MAINTAINABILITY=20
# SG_MAX_COUPLING=30
# SG_MAX_INHERITANCE=5

# --- Behavior ---
# SG_TARGET_FRAMEWORK=net9.0
# SG_DOTNET_TIMEOUT_MS=240000
# SG_MAX_VERIFIED=4
