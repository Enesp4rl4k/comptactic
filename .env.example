# Supabase credentials — copy this file to .env.local and fill in your project's values.
# Find them in the Supabase dashboard: Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Free plan tuning (default): slower sync + smaller save history to stay within quotas.
# Set to 0 after upgrading to Supabase Pro for faster realtime.
VITE_SUPABASE_FREE_TIER=1

# Passcode that gates the Admin panel (Account menu -> "Admin · room access",
# or open ?admin=1). Leave blank to keep the gate open during local dev.
VITE_ADMIN_CODE=
